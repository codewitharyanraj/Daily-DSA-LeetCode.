#include <bits/stdc++.h>
using namespace std;

class practices {
    public :
    //void star(int n) {
    static void star(int n) {
        for (int i = 0; i<n; i++) {
            for (int j =0; j<n; j++) {
                cout << "*";
            }
            cout << endl;
        }
    }
};

int main() {
    int t;
    cin>>t;
    for (int k=0; k<t; k++){
        int n;
        cin>>n;
        practices::star(n);
    }
}